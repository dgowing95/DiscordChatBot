DISCORD_TOKEN=
REDIS_HOST=redis
# Which LLM server docker compose runs: llamacpp or strata (a compose
# profile; only that one starts). Without this line neither starts.
COMPOSE_PROFILES=llamacpp
# The env file compose hands core (default .env). A second file for another
# branch (e.g. .env.v3, used as `docker compose --env-file .env.v3 up`) sets
# this to its own name, or core would still get .env.
#CORE_ENV_FILE=.env
# The bot's own LLM server and the model it serves (required). The bot
# requests LLM_MODEL and the compose `llamacpp` service serves exactly it
# (downloaded on first boot). To swap: edit it, then `docker compose up -d`.
LLM_MODEL=ggml-org/Qwen3.8-27B-GGUF:Q4_K_M
LLM_HOST="http://llamacpp:8081"
# The server's API key: a placeholder for llama.cpp (it does not check one)
LLM_API_KEY=llamacpp
# Extra headers for every request to LLM_HOST, name=value,... (a hosted API
# that needs them; OpenCode Go needs x-opencode-session=<any stable id>).
#LLM_EXTRA_HEADERS=
# Parallel slots: core reads them from the server's /props (llama.cpp and
# Strata report them), and keeps chat replies ahead of brain work when every
# slot is busy. LLM_SLOTS is only for a server whose /props does not say.
#LLM_SLOTS=
# Slots only chat may use (default 1). With 1 slot, other work runs while no
# chat reply is running or waiting.
#LLM_CHAT_RESERVED=1
# llama.cpp (compose only): TOTAL context, split across LLAMA_PARALLEL slots
# (per slot = LLAMA_CTX_SIZE / LLAMA_PARALLEL; keep 32000 or more per slot),
# and its prompt cache in host RAM (MiB). E.g. 4 slots of 40k:
#   LLAMA_PARALLEL=4
#   LLAMA_CTX_SIZE=160000
#LLAMA_CTX_SIZE=80000
#LLAMA_PARALLEL=1
#LLAMA_CACHE_RAM_MIB=8192
# --- Strata instead of llama.cpp (large mixture-of-experts models) ---
# Strata always checks a key: LLM_API_KEY is given to it as API_KEY too.
# LLM_MODEL is only the name core asks for (Strata answers any). See Strata's
# docs/DOCKER.md for each setting.
#COMPOSE_PROFILES=strata
#LLM_HOST="http://strata:8080"
#LLM_API_KEY=<16+ characters, e.g. openssl rand -hex 24>
#LLM_MODEL=qwen3.8-flash-next
#STRATA_MODEL=IQ3_XXS
#STRATA_FAMILY=qwen
# Model files you already have, in a Docker volume (mounted at /models). It
# must exist: `docker volume create strata-models` (empty is fine when Strata
# downloads the model itself)
#STRATA_MODELS_VOLUME=strata-models
#STRATA_MODEL_PATH=/models/IQ3_XXS
# Per slot; requests at once; off/on/cpu/gpu; extra engine settings
#STRATA_CONTEXT=32k
#STRATA_PARALLEL=2
#STRATA_VISION=on
#STRATA_SET=
# --- Image generation (diffusion) — separate service, see diffusionservice/ ---
# 1/0: offer the generate_image tool to the LLM (helm: diffusion.enabled)
IMAGE_GEN_ENABLED=1
# Base URL of the diffusion service (compose service name in local dev)
DIFFUSION_URL=http://diffusion:8000
# Smallest practical text-to-image model (~500MB, made for 1-4 step generation);
# also the model the compose `diffusion` service downloads on first boot.
# For prompt adherence and editing: black-forest-labs/FLUX.2-klein-4B with
# IMAGE_STEPS=4, 1024x1024 (~15GB download; IMAGE_QUANTIZE=nf4 on <16GB cards)
IMAGE_MODEL=stabilityai/sd-turbo
# Sampler steps (sd-turbo: 1-4, FLUX.2 klein: 4); lower = faster, slightly worse quality
#IMAGE_STEPS=4
#IMAGE_WIDTH=512
#IMAGE_HEIGHT=512
# none | nf4: 4-bit FLUX.2 [klein] (transformer + text encoder), which is what
# fits it on an 8GB card. Ignored for SD/SDXL models.
#IMAGE_QUANTIZE=none
# CFG scale. Unset = the pipeline's own default (7.5 SD1.5, 5.0 SDXL); higher
# follows the prompt more closely at the cost of contrast. Pinned for
# distilled models, which are trained without guidance: 0.0 for sd-turbo,
# Lightning, LCM and Hyper (so a negative prompt is inert and dropped), 1.0
# for FLUX.2 klein.
#IMAGE_GUIDANCE=
# Baseline "what must not appear", merged BEHIND the per-request negative the
# prompt rewriter produces, and the only one an image gets when that rewrite is
# off or fails. Compose and the chart both default to the line below, so set
# this only to REPLACE it. Dropped automatically on distilled models.
# Keep text/words/letters OUT of it: users do ask for text in images. Keep
# anatomy words ("deformed, bad anatomy") out too: they pull deliberately
# exaggerated bodies back to normal. Unused by FLUX.2.
#IMAGE_NEGATIVE_PROMPT=blurry, lowres, jpeg artifacts, extra limbs, extra fingers, watermark, signature, cropped, out of frame
# 1/0: encode prompts past CLIP's 77-token (~55 word) window instead of
# silently truncating them. Off falls back to the truncating path.
#IMAGE_LONG_PROMPT=1
# GPU mode: model = one component on the GPU at a time (default; text encoder
# runs in CPU RAM); sequential = lowest VRAM, slowest; none = all on GPU
#IMAGE_OFFLOAD=model
# Max queued image requests (images are always generated one at a time)
#IMAGE_QUEUE_SIZE=16
# Optional: fixed seed for reproducible images
#IMAGE_SEED=
# Seconds core waits on the diffusion service before giving up
#IMAGE_GEN_TIMEOUT=300
# An LLM call rewrites the request into an SDXL-shaped prompt + negative prompt
# before it reaches the service (core-side; covers the tool AND the
# /generate_image slash command). 1/0; off sends the request through verbatim.
# Skipped automatically for models that read plain sentences (FLUX.2).
#IMAGE_PROMPT_REWRITE_ENABLED=1
# By default the rewrite uses the bot's own LLM_MODEL / LLM_HOST / LLM_API_KEY. Set
# these to run it somewhere else (e.g. OpenRouter, as BRAIN_MODEL can).
#IMAGE_PROMPT_MODEL=
#IMAGE_PROMPT_LLM_HOST=
#IMAGE_PROMPT_LLM_API_KEY=
#IMAGE_PROMPT_TIMEOUT=60
# A vision call looks at each generated image before it is posted: what it
# shows (so the bot's caption is true) and what is missing, which earns
# IMAGE_REVIEW_RETRIES more attempts (default 1, max 2; 0 = check only).
# 1/0; off posts images unchecked.
# (off also removes view_image, how workflow helpers look at their pictures)
#IMAGE_REVIEW_ENABLED=1
#IMAGE_REVIEW_RETRIES=1
# By default the check uses the bot's own LLM_MODEL / LLM_HOST / LLM_API_KEY, which
# must then be a vision model (llama.cpp with the model's mmproj loaded).
#IMAGE_REVIEW_MODEL=
#IMAGE_REVIEW_LLM_HOST=
#IMAGE_REVIEW_LLM_API_KEY=
#IMAGE_REVIEW_TIMEOUT=60
# --- Tier 3 workflows (a big job in its own thread: plan, approve, steps) ---
# 0 removes /task and start_workflow (default 1)
#WORKFLOW_ENABLED=1
# Schedules, rules and follow-ups may start one, approved at once (default 1)
#WORKFLOW_FROM_AUTOMATIONS=1
# Seconds a helper's question in the thread waits for the requester (default 300)
#WORKFLOW_ASK_TIMEOUT=300
# Seconds the plan waits for Approve before it starts anyway (default 900)
#WORKFLOW_PLAN_APPROVAL_SECONDS=900
# Changes a plan may get before it must be approved or cancelled (default 3)
#WORKFLOW_PLAN_REVISIONS=3
# Steps in one plan (default 8)
#WORKFLOW_MAX_STEPS=8
# Backstops on one workflow: wall-clock seconds (default 3600 = 1 h), model
# turns across all its agents (default 300), and tokens in and out across all
# its agents (default 0 = off)
#WORKFLOW_TIMEOUT=3600
#WORKFLOW_MAX_TURNS=300
#WORKFLOW_MAX_TOKENS=0
# Workflows running at once in one server (default 1)
#WORKFLOW_MAX_PER_GUILD=1
# Local testing and E2E only: `!workflow <request>` starts a workflow directly.
#WORKFLOW_DEV_INJECT=0
# The workflow's helpers (subagents). Empty = the brain's connection (BRAIN_*),
# then the bot's own (LLM_*); the key only falls back for the same host.
#SUBAGENT_MODEL=
#SUBAGENT_LLM_HOST=
#SUBAGENT_LLM_API_KEY=
#SUBAGENT_REASONING_EFFORT=
#SUBAGENT_CALL_TIMEOUT_SECONDS=
# Backstop on one helper's model turns (default 100)
#SUBAGENT_MAX_TURNS=100
# Researchers running at once, cut to the slots a self-hosted server has beside
# chat's (default 2)
#SUBAGENT_MAX_CONCURRENT=2
# --- The server workspace (one Docker container per Discord server) ---
# Docker is REQUIRED: core exits at startup if it cannot reach the daemon
# (docker-compose.yaml mounts its socket). Tasks run there in their own
# folder; shared/ keeps what the server asks to keep.
# Container image (pulled at startup if missing; helm: brain.workspace.image)
WORKSPACE_IMAGE=python:3.14-slim
# Seconds unused before a workspace is saved and stopped (default 900)
#WORKSPACE_IDLE_SECONDS=900
# Seconds between saves of a running workspace that changed; 0 = only when
# it stops (default 1800)
#WORKSPACE_SNAPSHOT_INTERVAL_SECONDS=1800
# Workspaces running at once; the least recently used idle one stops first
# (default 4)
#WORKSPACE_MAX_WARM=4
# Task folders (jobs/<id>/) older than this many hours are deleted (default 72)
#WORKSPACE_JOB_RETENTION_HOURS=72
# Per container: memory cap in Docker's notation (e.g. 4g; swap capped at the
# same figure), CPUs (e.g. 2), processes (default 512, 0 = none). Empty = no cap.
#WORKSPACE_MEMORY_LIMIT=
#WORKSPACE_CPU_LIMIT=
#WORKSPACE_PIDS_LIMIT=512
# Max size (bytes) of one server's saved workspace in Redis (default 50000000)
#WORKSPACE_SNAPSHOT_MAX_BYTES=50000000
# How long an unused server's saved workspace survives in Redis, seconds
# (default 604800 = 7 days)
#WORKSPACE_SNAPSHOT_TTL_SECONDS=604800
# Seconds allowed for one save, and for all of them at shutdown (default 120)
#WORKSPACE_SNAPSHOT_TIMEOUT_SECONDS=120
# Most bytes of chat files (uploads, the bot's pictures) copied into a task's
# in/ folder, all together (default 25000000)
#WORKSPACE_INPUT_MAX_BYTES=25000000
# Label on this bot's containers, so two bots on one Docker daemon never
# remove each other's (default dcb-dev; the chart uses <namespace>-<release name>)
#WORKSPACE_INSTANCE=dcb-dev
# Start a server's workspace when the bot is about to answer there, so the
# brain finds it ready: every brain call runs in it (default 1; 0 = off)
#WORKSPACE_PREWARM=1
# Optional: Docker daemon to use (default: local unix:///var/run/docker.sock)
#DOCKER_HOST=unix:///var/run/docker.sock
# --- The brain (the agent behind ask_brain, the persona's one tool) ---
# Its LLM. Leave empty (default) to reuse the bot's own (LLM_MODEL /
# LLM_HOST / LLM_API_KEY). The bot's key is only sent to the bot's own server:
# a brain on another host needs its own key. To point it at a hosted
# OpenAI-compatible API (e.g. OpenRouter), set all three, e.g.:
#   BRAIN_MODEL=deepseek/deepseek-v4.1-flash-1017
#   BRAIN_LLM_HOST=https://openrouter.ai/api   (core appends /v1 itself)
#   BRAIN_LLM_API_KEY=sk-or-...
#BRAIN_MODEL=
#BRAIN_LLM_HOST=
#BRAIN_LLM_API_KEY=
# Reasoning effort (low/medium/high; default medium)
#BRAIN_REASONING_EFFORT=medium
# Wall-clock seconds ONE brain model call may take, the client's two retries
# included (default 600); also its per-read timeout
#BRAIN_CALL_TIMEOUT_SECONDS=600
# Backstops on ONE brain call (not budgets: the loop guard is what stops a
# stuck call): model turns (default 100) and wall-clock seconds, lane waits
# included (default 1800)
#BRAIN_MAX_TURNS=100
#BRAIN_TIMEOUT=1800
# The loop guard: the same tool with the same arguments this many times in a
# row (or eight calls that bring nothing new) earns a warning, and a second
# time stops the call with what it has (default 3)
#BRAIN_REPEAT_LIMIT=3
# Tool outputs kept whole in a long call's prompt; older ones are cut to their
# first and last 400 characters (default 6)
#BRAIN_TRIM_KEEP_RECENT=6
# Backstops for a reply the bot was not asked for (the random reply chance):
# model turns (default 40) and seconds (default 180)
#BRAIN_UNPROMPTED_MAX_TURNS=40
#BRAIN_UNPROMPTED_TIMEOUT=180
# Seconds the brain waits for the requester to answer its question in the
# channel (default 120; counted inside BRAIN_TIMEOUT)
#BRAIN_ASK_TIMEOUT=120
# Brain calls at once (default 3; each on a queue worker starts a spare
# worker), and seconds a call waits for a free one before "busy" (default 120)
#BRAIN_MAX_CONCURRENT=3
#BRAIN_QUEUE_WAIT=120
# Skills: how the brain solved a recurring job, saved per server and reused
# (SKILLS_ENABLED=0 turns them off; limits below are the defaults)
#SKILLS_ENABLED=1
#SKILLS_MAX_PER_GUILD=100
#SKILLS_MAX_VERSIONS=50
#SKILLS_MAX_BYTES=65536
#SKILLS_MAX_BODY_CHARS=8000
#SKILLS_MAX_FILES=10
#SKILLS_INDEX_MAX=20
# After a long brain job, a background call decides whether to save a skill
#SKILLS_REFLECTION_ENABLED=1
#SKILLS_REFLECTION_MIN_TOOL_CALLS=6
# The daily tidy-up: merges overlapping skills, retires ones unused for
# SKILLS_RETIRE_DAYS, sharpens descriptions (servers with 5+ skills)
#SKILLS_CURATOR_ENABLED=1
#SKILLS_CURATOR_INTERVAL_HOURS=24
#SKILLS_CURATOR_MIN_SKILLS=5
#SKILLS_RETIRE_DAYS=60
# Optional: root log level (DEBUG/INFO/WARNING/ERROR; default INFO)
#LOG_LEVEL=INFO
# Optional: how many prior channel messages to include in the prompt (default 5)
#MSG_HISTORY_LIMIT=5
# Optional: sliding (default) always sends the newest MSG_HISTORY_LIMIT
# messages; anchored keeps the start of the window fixed so the LLM server can
# reuse its prompt cache, and jumps to the newest window after
# MSG_HISTORY_REFRESH_MESSAGES new channel messages (default 10)
#MSG_HISTORY_MODE=sliding
#MSG_HISTORY_REFRESH_MESSAGES=10
# Optional: tokens of the LLM server's per-slot context kept free for the system
# prompt, tools and the answer; older history is dropped whole beyond that
#MSG_HISTORY_RESERVE_TOKENS=12000
# --- The persona (the personality that answers in chat) ---
# Its LLM. Empty (default) = the bot's own (LLM_MODEL / LLM_HOST /
# LLM_API_KEY); the bot's key is only sent to the bot's own server.
#PERSONA_MODEL=
#PERSONA_LLM_HOST=
#PERSONA_LLM_API_KEY=
# Reasoning effort sent to the LLM as the OpenAI-compat "reasoning_effort"
# field (low/medium/high; default medium)
#PERSONA_REASONING_EFFORT=medium
# Max model turns for ONE reply (default 4). A turn is one model response,
# however many tool calls it carries. The persona has one tool, ask_brain, so
# a reply is at most: ask the brain, maybe again, answer.
#PERSONA_MAX_TURNS=4
# Wall-clock seconds ONE model call may take, the client's own retries
# included (default 600). The client's timeout is per-read, so a server that
# keeps the connection warm while it works (OpenRouter pads non-streaming
# responses) is bounded only by this.
#PERSONA_CALL_TIMEOUT_SECONDS=600
# Optional: KV cache quantization type for the llamacpp service (llama.cpp -ctk/-ctv),
# default q4_0. Only affects the llamacpp container in docker-compose.
#LLAMA_CACHE_TYPE_K=q4_0
#LLAMA_CACHE_TYPE_V=q4_0
# --- Content guard (moderation of web and sandbox input) ---
# An OpenAI-compatible Moderations endpoint (OpenAI's is free). Fails open:
# no key, or no answer, allows.
#CONTENT_GUARD_API_KEY=
# Optional: defaults to https://api.openai.com/v1
#CONTENT_GUARD_BASE_URL=https://api.openai.com/v1
# Optional: moderation model name, e.g. text-moderation-latest (default: server default)
#CONTENT_GUARD_MODEL=
# Optional: how aggressively to retry 429/5xx from the free moderation endpoint
#CONTENT_GUARD_MAX_RETRIES=2
#CONTENT_GUARD_RETRY_BACKOFF=2
# Optional: seconds a verdict for the same query/URL stays cached (default 600)
#CONTENT_GUARD_CACHE_TTL_SECONDS=600
# Optional: 0 disables the guard (default: enabled)
#CONTENT_GUARD_ENABLED=1
# Optional: 1 logs the guard's per-request detail (default: off)
#CONTENT_GUARD_DEBUG=0
# --- Web search (web_search) ---
# It reads the top results itself and an LLM call writes a short brief with
# sources. 0 returns the search results alone (default: on)
#RESEARCH_BRIEF_ENABLED=1
# Results read in full (max 5), and characters of each given to the brief
#RESEARCH_PAGES=3
#RESEARCH_PAGE_CHARS=6000
# Seconds to wait for the pages, and for the brief
#RESEARCH_FETCH_TIMEOUT=25
#RESEARCH_TIMEOUT=90
# By default the brief uses the bot's own LLM_MODEL / LLM_HOST / LLM_API_KEY. Set
# these to write it on another server, so it does not take llama.cpp's slot.
#RESEARCH_MODEL=
#RESEARCH_LLM_HOST=
#RESEARCH_LLM_API_KEY=
# --- Reading links (fetch_url) ---
# The browser service (compose service `browser`) for pages that need their
# scripts run; compose defaults it to http://browser:8000. Empty = no fallback.
#BROWSER_URL=http://browser:8000
# A plain fetch with less text than this goes to the browser (default 400)
#BROWSER_MIN_CHARS=400
# Characters per part the model reads, and most kept per page (defaults 10000 / 200000)
#WEB_FETCH_PART_CHARS=10000
#WEB_FETCH_MAX_CHARS=200000
# Most bytes downloaded per page, and seconds to wait (defaults 5000000 / 15)
#WEB_FETCH_MAX_BYTES=5000000
#WEB_FETCH_TIMEOUT=15
# Seconds a page / a YouTube transcript / a failure stays cached in Redis
# (defaults 21600 / 2592000 / 300)
#WEB_CACHE_TTL_SECONDS=21600
#WEB_CACHE_VIDEO_TTL_SECONDS=2592000
#WEB_CACHE_FAILURE_TTL_SECONDS=300
# Browser service: pages at once, seconds per render, seconds to let scripts
# settle (defaults 2 / 30 / 5); core reads the last two to know how long to wait
#BROWSER_CONCURRENCY=2
#BROWSER_TIMEOUT=30
#BROWSER_SETTLE_SECONDS=5
# --- Prometheus metrics ---
# Port to serve /metrics on (helm: metrics.port); empty or 0 disables the
# metrics server (helm: metrics.enabled=false)
#METRICS_PORT=9464
# --- Queue concurrency (core worker pool) ---
# Number of queue worker tasks; each handles one message at a time. With 2,
# a message stuck in a slow tool (sandbox / image generation) no longer
# blocks messages from other channels. Same-channel messages stay ordered.
#QUEUE_WORKERS=2
# Max messages waiting in the queue (bounded). Once full, new messages are
# dropped instead of piling up — mentioned ones get a short "busy" reply.
#QUEUE_MAX_SIZE=10
# Persistent schedules and message rules (stored in Redis)
#AUTOMATIONS_ENABLED=1
#AUTOMATIONS_TIMEZONE=Europe/London
#SCHEDULE_MIN_INTERVAL_HOURS=4
#SCHEDULE_MAX_PER_GUILD=1
#RULE_MAX_PER_GUILD=4
#RULE_COOLDOWN_SECONDS=60
# Follow-ups the bot sets itself (own quota; spaced SCHEDULE_MIN_INTERVAL_HOURS apart)
#FOLLOWUP_MAX_PER_GUILD=3
# Discord server events (needs Create Events on the bot's role and the asker)
#EVENTS_ENABLED=1
# Optional: default (0) drops the model's <think> reasoning entirely;
# set to 1 to send it as spoiler-hidden follow-up message(s) instead
# (closed by default, click to reveal)
#SHOW_THINKING=0
# Optional: 0 stops the bot posting each release's "What's new" embed (once
# per server, after the first reply on a new version). Default on. Only does
# anything in a release image, which sets APP_VERSION at build time; set
# APP_VERSION here yourself to try it locally.
#WHATS_NEW_ENABLED=1
#APP_VERSION=v0.0-dev

# Occasional two-message replies (one generation, plain channel messages).
# Chance is an opportunity, not a forced split; 0 disables (valid range 0..1).
# Cooldown counts successful replies per channel and resets on restart.
#DOUBLE_REPLY_CHANCE=0.08
#DOUBLE_REPLY_COOLDOWN_REPLIES=10
# --- Voice calls (/voice join; see docs/voice.md) ---
# Needs the `voice` (sidecar) and `speech` compose services. Default off.
#VOICE_ENABLED=1
# Seconds the bot stays after the last person leaves the call
#VOICE_IDLE_LEAVE_SECONDS=30
# Transcribed clips kept in the voice prompt, and how many more it grows by
# before rebasing (an anchored window, so llama.cpp can reuse its cache)
#VOICE_HISTORY_LIMIT=10
#VOICE_HISTORY_REFRESH=10
# After someone says only the wake phrase, their next words within this many
# seconds count as the request
#VOICE_FOLLOWUP_SECONDS=8
# 1 lets the model think before a spoken reply (slower first word). Default off.
#VOICE_THINKING=0
# Kokoro voice when a server has not picked one (/voice voice)
#VOICE_DEFAULT_VOICE=af_heart
# Silence (ms) that ends someone's utterance, read by the voice sidecar
#VOICE_SILENCE_MS=800
# Minimum seconds between two cache-warming prefills of a call's prompt
#VOICE_PREFILL_MIN_SECONDS=5
# Local testing only: "!voice_join <channel id>" / "!voice_say <text>" drive
# a call from text messages
#VOICE_DEV_INJECT=0
# Shared secret between core and the voice sidecar. In compose the sidecar
# listens on the whole compose network; set this so only core can drive it.
#VOICE_BRIDGE_TOKEN=
# Where core finds the voice sidecar and the speech service (compose sets
# both to its own services)
#VOICE_BRIDGE_URL=ws://voice:8765
#SPEECH_URL=http://speech:8000
# 1 logs every transcript and spoken sentence (everything said in a call)
#VOICE_DEBUG=0
# Speech service (CPU): Whisper model and threads; Kokoro threads
#STT_MODEL=small.en
#STT_THREADS=4
#TTS_THREADS=4
# --- Manual/live testing ---
# Discord webhook URL for POSTing test messages without a real Discord
# client/account — see AGENTS.md "Manual/live testing via a Discord
# webhook". Not read by the app itself; a standing convenience only.
# NEVER point this at a production channel/server, and never commit a real
# value here.
#TEST_WEBHOOK_URL=
