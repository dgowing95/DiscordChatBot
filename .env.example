DISCORD_TOKEN=
REDIS_HOST=redis
LLM_HOST="http://llamacpp:8081"
LLM_PASS=llamacpp
# --- Image generation (diffusion) — separate service, see diffusionservice/ ---
# 1/0: offer the generate_image tool to the LLM (helm: diffusion.enabled)
IMAGE_GEN_ENABLED=1
# Base URL of the diffusion service (compose service name in local dev)
DIFFUSION_URL=http://diffusion:8000
# Smallest practical text-to-image model (~500MB, made for 1-4 step generation);
# also the model the compose `diffusion` service downloads on first boot.
# For prompt adherence and editing: black-forest-labs/FLUX.2-klein-4B with
# IMAGE_STEPS=4, 1024x1024 (~15GB download; IMAGE_QUANTIZE=nf4 on <16GB cards)
IMAGE_MODEL=stabilityai/sd-turbo
# Sampler steps (sd-turbo: 1-4, FLUX.2 klein: 4); lower = faster, slightly worse quality
#IMAGE_STEPS=4
#IMAGE_WIDTH=512
#IMAGE_HEIGHT=512
# none | nf4: 4-bit FLUX.2 [klein] (transformer + text encoder), which is what
# fits it on an 8GB card. Ignored for SD/SDXL models.
#IMAGE_QUANTIZE=none
# CFG scale. Unset = the pipeline's own default (7.5 SD1.5, 5.0 SDXL); higher
# follows the prompt more closely at the cost of contrast. Pinned for
# distilled models, which are trained without guidance: 0.0 for sd-turbo,
# Lightning, LCM and Hyper (so a negative prompt is inert and dropped), 1.0
# for FLUX.2 klein.
#IMAGE_GUIDANCE=
# Baseline "what must not appear", merged BEHIND the per-request negative the
# prompt rewriter produces, and the only one an image gets when that rewrite is
# off or fails. Compose and the chart both default to the line below, so set
# this only to REPLACE it. Dropped automatically on distilled models.
# Keep text/words/letters OUT of it: users do ask for text in images. Keep
# anatomy words ("deformed, bad anatomy") out too: they pull deliberately
# exaggerated bodies back to normal. Unused by FLUX.2.
#IMAGE_NEGATIVE_PROMPT=blurry, lowres, jpeg artifacts, extra limbs, extra fingers, watermark, signature, cropped, out of frame
# 1/0: encode prompts past CLIP's 77-token (~55 word) window instead of
# silently truncating them. Off falls back to the truncating path.
#IMAGE_LONG_PROMPT=1
# GPU mode: model = one component on the GPU at a time (default; text encoder
# runs in CPU RAM); sequential = lowest VRAM, slowest; none = all on GPU
#IMAGE_OFFLOAD=model
# Max queued image requests (images are always generated one at a time)
#IMAGE_QUEUE_SIZE=16
# Optional: fixed seed for reproducible images
#IMAGE_SEED=
# Seconds core waits on the diffusion service before giving up
#IMAGE_GEN_TIMEOUT=300
# An LLM call rewrites the request into an SDXL-shaped prompt + negative prompt
# before it reaches the service (core-side; covers the tool AND the
# /generate_image slash command). 1/0; off sends the request through verbatim.
# Skipped automatically for models that read plain sentences (FLUX.2).
#IMAGE_PROMPT_REWRITE_ENABLED=1
# By default the rewrite uses the bot's own MODEL / LLM_HOST / LLM_PASS. Set
# these to run it somewhere else (e.g. OpenRouter, as SANDBOX_MODEL can).
#IMAGE_PROMPT_MODEL=
#IMAGE_PROMPT_LLM_HOST=
#IMAGE_PROMPT_LLM_API_KEY=
#IMAGE_PROMPT_TIMEOUT=60
# A vision call looks at each generated image before it is posted: what it
# shows (so the bot's caption is true) and what is missing, which earns
# IMAGE_REVIEW_RETRIES more attempts (default 1, max 2; 0 = check only).
# 1/0; off posts images unchecked.
#IMAGE_REVIEW_ENABLED=1
#IMAGE_REVIEW_RETRIES=1
# By default the check uses the bot's own MODEL / LLM_HOST / LLM_PASS, which
# must then be a vision model (llama.cpp with the model's mmproj loaded).
#IMAGE_REVIEW_MODEL=
#IMAGE_REVIEW_LLM_HOST=
#IMAGE_REVIEW_LLM_API_KEY=
#IMAGE_REVIEW_TIMEOUT=60
# --- Code sandbox (run_code_sandbox tool; agents.sandbox DockerSandboxClient) ---
# 1/0: offer the run_code_sandbox tool to the LLM (helm: sandbox.enabled).
# Needs the Docker socket mounted into core (see docker-compose.yaml).
SANDBOX_ENABLED=1
# Container image for the sandbox workspace (pulled once onto the daemon)
SANDBOX_IMAGE=python:3.14-slim
# Max model turns for one sandbox task
SANDBOX_MAX_TURNS=10
# Wall-clock seconds before a sandbox task is stopped (container removed)
SANDBOX_TIMEOUT=600
# Max seconds the sandbox's ask_user tool waits for a reply in its Discord
# thread before telling the model to proceed on its own judgement
SANDBOX_ASK_USER_TIMEOUT=300
# Wall-clock seconds allowed to persist a thread's workspace snapshot to
# Redis on container teardown (runs AFTER SANDBOX_TIMEOUT; generous because,
# with the Memory capability, this is also where its own two extra
# local-model calls run)
SANDBOX_PERSIST_TIMEOUT_SECONDS=180
# Seconds of silence on one HTTP request to the sandbox's LLM before the
# client gives up on it (down from the OpenAI client's 600s default). Catches
# a hung connection or a server that sends nothing.
SANDBOX_REQUEST_TIMEOUT_SECONDS=180
# How many times that client retries a failed request (0 disables retries).
# One model call is also wall-clock bounded at (1 + this) x the timeout
# above, which is what catches a server that dribbles keep-alive padding
# while it works (e.g. OpenRouter's non-streaming responses) and so never
# trips the per-read timeout.
SANDBOX_MAX_RETRIES=2
# Max size (bytes) of one thread's stored workspace snapshot in Redis
SANDBOX_SNAPSHOT_MAX_BYTES=50000000
# How long an unused thread's workspace snapshot survives in Redis (seconds)
SANDBOX_SNAPSHOT_TTL_SECONDS=604800
# Optional: Docker daemon to use (default: local unix:///var/run/docker.sock)
#DOCKER_HOST=unix:///var/run/docker.sock
# LLM for the nested sandbox agent. Leave empty (default) to reuse the main
# bot's LLM (MODEL / LLM_HOST / LLM_PASS). To point it at a hosted
# OpenAI-compatible API (e.g. OpenRouter), set all three, e.g.:
#   SANDBOX_MODEL=deepseek/deepseek-v4-flash-0731
#   SANDBOX_LLM_HOST=https://openrouter.ai/api   (core appends /v1 itself)
#   SANDBOX_LLM_API_KEY=sk-or-...
#SANDBOX_MODEL=
#SANDBOX_LLM_HOST=
#SANDBOX_LLM_API_KEY=
# Model — single place to change it for local runs: the bot requests this name and
# the compose `llamacpp` service serves exactly it (downloaded on first boot).
# To swap: edit this, then `docker compose up -d`.
MODEL=ggml-org/Qwen3.8-27B-GGUF:Q4_K_M
# Optional: root log level (DEBUG/INFO/WARNING/ERROR; default INFO)
#LOG_LEVEL=INFO
# Optional: how many prior channel messages to include in the prompt (default 5)
#MSG_HISTORY_LIMIT=5
# Optional: sliding (default) always sends the newest MSG_HISTORY_LIMIT
# messages; anchored keeps the start of the window fixed so the LLM server can
# reuse its prompt cache, and jumps to the newest window after
# MSG_HISTORY_REFRESH_MESSAGES new channel messages (default 10)
#MSG_HISTORY_MODE=sliding
#MSG_HISTORY_REFRESH_MESSAGES=10
# Optional: tokens of the LLM server's per-slot context kept free for the system
# prompt, tools and the answer; older history is dropped whole beyond that
#MSG_HISTORY_RESERVE_TOKENS=12000
# Optional: reasoning effort sent to the LLM as the OpenAI-compat
# "reasoning_effort" field (low/medium/high; default medium)
#REASONING_EFFORT=medium
# Optional: max model turns for ONE reply from the main agent (default 20).
# A turn is one model response, however many tool calls it carries; a reply
# that chains several sandbox/image calls overruns the SDK's own default of
# 10 and loses the whole answer.
#LLM_MAX_TURNS=20
# Optional: wall-clock seconds ONE model call from the main agent may take,
# the client's own retries included (default 600, the same as the OpenAI
# client's timeout). The client's timeout is per-read, so a server that keeps
# the connection warm while it works (OpenRouter pads non-streaming
# responses) was never bounded before this.
#LLM_CALL_TIMEOUT_SECONDS=600
# Optional: KV cache quantization type for the llamacpp service (llama.cpp -ctk/-ctv),
# default q4_0. Only affects the llamacpp container in docker-compose.
#LLAMA_ARG_CACHE_TYPE_K=q4_0
#LLAMA_ARG_CACHE_TYPE_V=q4_0
# Web-tool safety guard uses the OpenAI Moderations endpoint (free):
#OPENAI_API_KEY=
# Optional: defaults to https://api.openai.com/v1
#OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: moderation model name, e.g. text-moderation-latest (default: server default)
#MODERATION_MODEL=
# Optional: how aggressively to retry 429/5xx from the free moderation endpoint
#CONTENT_GUARD_MAX_RETRIES=2
#CONTENT_GUARD_RETRY_BACKOFF=2
# Optional: seconds a verdict for the same query/URL stays cached (default 600)
#MODERATION_CACHE_TTL=600
# Optional: 0 disables the NSFW/malicious-content guard on web_search/fetch_url (default: enabled)
#CONTENT_GUARD_ENABLED=1
# Optional: 0 silences the guard's debug logging (default: enabled)
#CONTENT_GUARD_DEBUG=1
# --- Prometheus metrics ---
# Port to serve /metrics on (helm: metrics.port); empty or 0 disables the
# metrics server (helm: metrics.enabled=false)
#METRICS_PORT=9464
# --- Queue concurrency (core worker pool) ---
# Number of queue worker tasks; each handles one message at a time. With 2,
# a message stuck in a slow tool (sandbox / image generation) no longer
# blocks messages from other channels. Same-channel messages stay ordered.
#WORKER_COUNT=2
# Max messages waiting in the queue (bounded). Once full, new messages are
# dropped instead of piling up — mentioned ones get a short "busy" reply.
#QUEUE_MAX_SIZE=10
# Persistent schedules and message rules (stored in Redis)
#AUTOMATIONS_ENABLED=1
#AUTOMATIONS_TIMEZONE=Europe/London
#SCHEDULE_MIN_INTERVAL_HOURS=4
#SCHEDULE_MAX_PER_GUILD=1
#RULE_MAX_PER_GUILD=4
#RULE_COOLDOWN_SECONDS=60
# Optional: default (0) drops the model's <think> reasoning entirely;
# set to 1 to send it as spoiler-hidden follow-up message(s) instead
# (closed by default, click to reveal)
#SHOW_THINKING=0
# Optional: 0 stops the bot posting each release's "What's new" embed (once
# per server, after the first reply on a new version). Default on. Only does
# anything in a release image, which sets APP_VERSION at build time; set
# APP_VERSION here yourself to try it locally.
#WHATS_NEW_ENABLED=1
#APP_VERSION=v0.0-dev

# Occasional two-message replies (one generation, plain channel messages).
# Chance is an opportunity, not a forced split; 0 disables (valid range 0..1).
# Cooldown counts successful replies per channel and resets on restart.
#DOUBLE_REPLY_CHANCE=0.08
#DOUBLE_REPLY_COOLDOWN_REPLIES=10
# --- Voice calls (/voice join; see docs/voice.md) ---
# Needs the `voice` (sidecar) and `speech` compose services. Default off.
#VOICE_ENABLED=1
# Seconds the bot stays after the last person leaves the call
#VOICE_IDLE_LEAVE_SECONDS=30
# Transcribed clips kept in the voice prompt, and how many more it grows by
# before rebasing (an anchored window, so llama.cpp can reuse its cache)
#VOICE_HISTORY_LIMIT=10
#VOICE_HISTORY_REFRESH=10
# After someone says only the wake phrase, their next words within this many
# seconds count as the request
#VOICE_FOLLOWUP_SECONDS=8
# 1 lets the model think before a spoken reply (slower first word). Default off.
#VOICE_THINKING=0
# Kokoro voice when a server has not picked one (/voice voice)
#VOICE_DEFAULT_VOICE=af_heart
# Silence (ms) that ends someone's utterance, read by the voice sidecar
#VOICE_SILENCE_MS=800
# Minimum seconds between two cache-warming prefills of a call's prompt
#VOICE_PREFILL_MIN_SECONDS=5
# Local testing only: "!voice_join <channel id>" / "!voice_say <text>" drive
# a call from text messages
#VOICE_DEV_INJECT=0
# Speech service (CPU): Whisper model and threads; Kokoro threads
#STT_MODEL=small.en
#STT_THREADS=4
#TTS_THREADS=4
# --- Manual/live testing ---
# Discord webhook URL for POSTing test messages without a real Discord
# client/account — see AGENTS.md "Manual/live testing via a Discord
# webhook". Not read by the app itself; a standing convenience only.
# NEVER point this at a production channel/server, and never commit a real
# value here.
#TEST_WEBHOOK_URL=
